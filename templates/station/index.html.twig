							<div class="form-group">
								<label for="stationSelect">Stations disponibles :</label>
								<select id="stationSelect" name="station" class="form-control" onchange="document.getElementById('stationForm').submit();">
									{% for sta in stationmeteos %}
										<option value="{{ sta.id }}" {% if sta.id == 2 %}selected{% endif %}>
											{{ sta.ville }} - {{ sta.user.prenom }}
										</option>
									{% endfor %}
								</select>
							</div>
						</form>
					</div>
				</div>
				{% endif %}
				
