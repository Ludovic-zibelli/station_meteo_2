{% extends 'base.html.twig' %}

{% block body %}
    {% if alerte %}
	<div class="container-fluid index">
        <div class="row">
            <div class="col-12">
				<div class="card  " style="">
					<div class="card-header text-white bg-danger">
						<img src="{{ asset('/images/attention.png') }}" width="30" height="30" alt="Attention">
						<strong>  ALERTE METEO  </strong>
						<img src="{{ asset('/images/attention.png') }}" width="30" height="30" alt="Attention">
					</div>
					{% for al in alerte %}
					{% set couleurs = {
						1: "#15ed13",  
						2: "#f9ff00",  
						3: "#f7a401",    
						4: "#e71919"    
					} %}
					
					<div class="card-body" style="background-color:{{ couleurs[al.level] ?? 'Niveau inconnu' }};">
						<div class="row">
							<div class="col-2 d-flex align-items-center justify-content-center">
								<img src="{{ asset('/images/') }}{{ al.pictogramme }}" width="180" height="180" alt="Attention">
							</div>
							<div class="col-10">
								{% set niveau = {
									1: "Vert",
									2: "Jaune",
									3: "Orange",
									4: "Rouge"
								} %}
								{% set phenomenes = {
									1: "Vent",
									2: "Pluie",
									3: "Orages",
									4: "Crues",
									5: "Neige / Verglas",
									6: "Canicule",
									7: "Grand froid",
									8: "Avalanches",
									9: "Vagues submersion"
								} %}
									<p class="card-text">{{ al.CreatdAt|date("d/m/Y H:i")  }}</p>
									<p class="card-text">{{ al.origine }} Vigilance <strong>{{ niveau[al.level] ?? 'Niveau inconnu' }}</strong> </p>
									<p class="card-text"><strong>{{ phenomenes[al.codephenomene] ?? 'Phénomène inconnu' }} </strong></p>
									<p class="card-text">{{ al.message }}</p>
								{% endfor %}
							</div>
						</div>
					</div>
				</div>
            </div>
        </div>
    {% endif %}

	<div class="row">
			<div class="col-md-12 col-sm-12 col-lg-12 text-center">
			<div class="card" style="width: auto;">
			<div class="card-header">
				<h3>Bienvenu sur la page web de la Station Météo DIY de L'HÔPITAL(57)</h3>
			</div>
		  	<div class="card-body">
		    <p class="card-text">
				<div class="container">
					
					<p>Notre station météo est un projet <strong>fait maison</strong>, avec une structure entièrement <strong>imprimée en 3D</strong>. Elle est équipée de plusieurs capteurs pour une surveillance précise des conditions météorologiques :</p>
			
					<h2>📡 Équipements</h2>
					<ul>
						<li><strong>Anémomètre</strong> – mesure la vitesse du vent</li>
						<li><strong>Pluviomètre</strong> – enregistre les précipitations</li>
						<li><strong>Girouette</strong> – indique la direction du vent</li>
						<li><strong>Capteurs de température et de pression atmosphérique</strong></li>
					</ul>
			
					<h2>💡 Technologie embarquée</h2>
					<p>Le cœur de la station est un <strong>ESP32 avec connectivité Wi-Fi</strong>. Toutes les données sont collectées et envoyées à un serveur toutes les 30 secondes, garantissant un suivi en temps réel.</p>
			
					<h2>🔋 Alimentation autonome</h2>
					<p>Pour une autonomie maximale, la station est alimentée par un <strong>panneau solaire de 9V</strong> et une <strong>batterie de 12 000 mAh</strong>.</p>
			
					<div class="footer">
						<p>📌<a class="nav-link" href="{{ path('presentation') }}">En savoir plus sur la station</a></p>
					</div>
				</div>
			
		  </div> 
		</div>
	</div>
	</div>
	
	<div class="row donnee_meteo">
