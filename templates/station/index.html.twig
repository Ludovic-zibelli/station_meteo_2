													<td class="align-middle" style="font-size: 12px;">Ensoleilement <i class="wi wi-day-sunny" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[2].sun_hours}} H</td>
												</tr>
												<tr class="table-active">
													<td class="align-middle" style="font-size: 12px;">Risque de gel <i class="wi wi-snowflake-cold" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[2].probafrost }} %</td>
												</tr>
												<tr>
													<td class="align-middle" style="font-size: 12px;">Risque de broullard <i class="wi wi-windy" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[2].probafog }} %</td>
												</tr>
												<tr class="table-active">
													<td class="align-middle" style="font-size: 12px;">Risque de vent 70km/h</td>
													<td style="font-size: 12px;">{{ meteo.forecast[2].probawind70 }} %</td>
												</tr>
												<tr>
													<td class="align-middle" style="font-size: 12px;">Risque de vent 100km/h</td>
													<td style="font-size: 12px;">{{ meteo.forecast[2].probawind100 }} %</td>
												</tr>
											</tbody>
										  </table>
										</div>
									</div>
								</div>	 
								<div class="card-body col-md-3 col-sm-3 col-lg-3">
									<div class="card shadow-lg">
										<h5 class="card-header">{{ meteo.forecast[3].datetime|date("d/m/Y")}}</h5>
										<div class="card-body">
											<img src="{{ asset('images/meteo/' ~ weatherIcon3) }}" width=200 height=200 alt="Météo aujourd'hui">
											<div class="row">
												
												<div class="col-md-5 col-sm-5 col-lg-5">
													<h5>Mini</h5>
													<p>{{ meteo.forecast[3].tmin }}°C</p>
												</div>	
												<div class="col-md-2 col-sm-2 col-lg-2">
													<i class="wi wi-thermometer" style="font-size: 40px;"></i>
												</div>
												<div class="col-md-5 col-sm-5 col-lg-5">
													<h5>Maxi</h5>
													<p>{{ meteo.forecast[3].tmax }}°C</p>
												</div>	
											</div>
										  <table class="table table-secondary">
											
											<tbody>
												
												<tr>
													<td class="align-middle" style="font-size: 12px;">Vent/Rafale <i class="wi wi-strong-wind" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].wind10m }} Km/h |{{ meteo.forecast[3].gust10m }}</td>
												</tr>
											
												<tr class="table-active">
													<td class="align-middle" style="font-size: 12px;">Direction du vent</td>
													<td><i class="wi wi-wind towards-{{ meteo.forecast[3].dirwind10m }}-deg" style="font-size: 30px;"></i></td>
												</tr>
												<tr>
													<td class="align-middle" style="font-size: 12px;">Pluie <i class="wi wi-raindrops" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].rr10 }} mm</td>
												</tr>
												<tr class="table-active">
													<td class="align-middle" style="font-size: 12px;">Risque de pluie <i class="wi wi-raindrops" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].probarain }} %</td>
												</tr>
												<tr>
													<td class="align-middle" style="font-size: 12px;">Ensoleilement <i class="wi wi-day-sunny" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].sun_hours}} H</td>
												</tr>
												<tr class="table-active">
													<td class="align-middle" style="font-size: 12px;">Risque de gel <i class="wi wi-snowflake-cold" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].probafrost }} %</td>
												</tr>
												<tr>
													<td class="align-middle" style="font-size: 12px;">Risque de broullard <i class="wi wi-windy" style="font-size: 20px;"></i></td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].probafog }} %</td>
												</tr>
												<tr class="table-active">
													<td class="align-middle" style="font-size: 12px;">Risque de vent 70km/h</td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].probawind70 }} %</td>
												</tr>
												<tr>
													<td class="align-middle" style="font-size: 12px;">Risque de vent 100km/h</td>
													<td style="font-size: 12px;">{{ meteo.forecast[3].probawind100 }} %</td>
												</tr>
											</tbody>
										  </table>
										</div>
									</div>
								</div>	 
									{% else %}
									<p>Aucune donnée disponible.</p>
									{% endif %}	 
								</div>
							</div>
						</div>
					</div>
					</div>
  				
					  <div class="row text-center">
						<div class="col-md-12 col-sm-12 col-lg-12">
							<div class="card">
								<div class="card-header">
									<h5 class="card-title text-center">Image satellite Météo</h5>
								</div>
								<div class="card-body">
									<div class="row">
										
										<div class="col" >
										  <iframe sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox" src="https://widgets.meteox.com/fr-FR/widgets/radar/continent/eu/rain" style="width:100%!important;max-width:600px!important;max-height:600px!important;height:600px!important;padding:0px;border:none!important;box-sizing:border-box!important;" scrolling="yes" frameborder="0"></iframe>
										</div>
										<div class="col">
										  <iframe sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox" src="https://widgets.meteox.com/fr-FR/widgets/radar/continent/eu/satellite" style="width:100%!important;max-width:600px!important;max-height:600px!important;height:100%!important;padding:0px;border:none!important;box-sizing:border-box!important;" scrolling="no" frameborder="0"></iframe>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
			  </div>

			</div>
		</div>
		<div class="row articles_home">
			<div class="card w-100">
				<div class="card-header">
					<h5 class="card-title text-center">Articles</h5>
				</div>
				<div class="card-body">
					<div class="row">
						{% for article in articles %}
							<div class="col-md-4 col-sm-6 col-lg-4 mb-4 d-flex">
								<div class="card card_articles h-100 w-100">
									{% if article.image %}
										<img src="{{ vich_uploader_asset(article, 'imageFile') }}" class="card-img-top" alt="{{ article.titre }}">
									{% else %}
										<img src="{{ asset('/images/logo_meteo.png') }}" class="card-img-top" alt="{{ article.titre }}">
									{% endif %}
									<div class="card-body">
										<a href="{{ path('article.show', {id: article.id}) }}"><h5 class="card-title">{{ article.titre }}</h5></a>
										<div class="card-text">{{ article.content|striptags|slice(0, 100)|raw }}</div>
										<p class="card-text"><small class="text-muted"><a href="{{ path('article.show', {id: article.id}) }}">Lire la suite</a></small></p>
									</div>
									<div class="card-footer">
										<p>Auteur de l'article {{ article.auteur }} | Edité le {{ article.CreatedAt|date("d/m/Y H:i") }}</p>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
				</div>
			</div>
		</div>
<section id="contact" >
	{{ form_start(form) }}
	<div class="row contact_home">
		<div class="col-md-12 col-sm-12 col-lg-12">
			<div class="card">
			  <div class="card-header">
			    <h5>Contact</h5>
			  </div>
				{% for message in app.flashes('success')%}
					<div class="alert alert-success">
						{{ message }}
					</div>
				{% endfor %}
			  <div class="card-body">
				  <div class="row">
					  <div class="col">
						  <p>Vous avez une question n’hesitez pas contactez nous avec le formulaire ci-dessous</p>
					  </div>
				  </div>
				  <div class="row">
					  <div class="col">
						  <h6 class="card-subtitle mb-2 text-muted">Nom</h6>
						  {{ form_widget(form.nom) }}
					  </div>
					  <div class="col">
						  <h6 class="card-subtitle mb-2 text-muted">Prenom</h6>
						  {{ form_widget(form.prenom) }}
					  </div>
				  </div>
				  <div class="row">
					  <div class="col">
						  <h6 class="card-subtitle mb-2 text-muted">E-mail</h6>
						  {{ form_widget(form.email) }}
					  </div>
				  </div>
				  <div class="row">
					  <div class="col">
						  <h6 class="card-subtitle mb-2 text-muted">Message</h6>
						  {{ form_widget(form.message) }}
					  </div>
				  </div>
				  <div class="row envoi_contact">
					  <div class="col">
						  <button class="btn btn-primary btn-block" type="submit">Envoyer</button>
					  </div>
				  </div>
				  {{ form_end(form) }}
				  </div>
			  </div>
			</div>
		</div>
	</div>
</section>
		
</div>


{% endblock %}
