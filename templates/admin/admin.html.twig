{% extends 'base.html.twig' %}

{% block title %}Tableau de bord du site{% endblock %}

{% block body %}
    <?php header('Access-Control-Allow-Origin: *'); ?>
    <div class="container-fluid">
        <h1 class="text-center">Taleau de bord du site</h1>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="collapse navbar-collapse" id="navbarText">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item active">
                        <a class="nav-link" href="{{ path('admin.article') }}">Articles <span class="sr-only">(current)</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('alertemeteo')}}">Alertes Meteo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('gestionstation') }}">Gestion des Stations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('user') }}">Utilisateurs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.infobdd') }}">Base de données</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin.apigestion') }}">Gestion API</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('logout') }}">Se déconecter</a>
                    </li>
                </ul>
                <span class="navbar-text">
      Bienvenu {{ app.user.prenom }} {{ app.user.nom }}({{ app.user.email }})
    </span>
            </div>
        </nav>
        <div class="card mt-3">
            <div class="card-header text-center">
                <h2>Configuration du Site</h2>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 text-center mb-3">
                        <h5>Mode maintenance</h5>
                        <p>Le mode maintenance permet de mettre le site en pause pour effectuer des modifications</p>
                        <form method="post" action="{{ path('admin.maintenance') }}">
                            <button type="submit" class="btn btn-warning">
                                {% if maintenance %}
                                    Désactiver le mode maintenance
                                {% else %}
                                    Activer le mode maintenance
                                {% endif %}
                            </button>
                        </form>
                      {% if maintenance %}
                        <div class="alert alert-warning mt-2">
                            <strong>Le site est actuellement en maintenance !</strong><br>
                            <small>Dernière modification : {{ date_time_main|date("d/m/Y H:i") }}</small>
                        </div>
                    {% else %}
                        <div class="alert alert-success mt-2">
                            <strong>Le site est accessible.</strong><br>
                            <small>Dernière modification : {{ date_time_main|date("d/m/Y H:i") }}</small>
                        </div>
                    {% endif %}
                    </div>
                    <div class="col-6 text-center mb-3">
                    <h5>Affichage du menu des Stations</h5>
                    <p>Réglage pour afficher ou caher le menu deroulent des staitons</p>
                        <form method="post" action="{{ path('admin.view') }}">
                            <button type="submit" class="btn btn-info">
                                {% if view_station %}
                                    Cacher le menu des stations
                                {% else %}
                                    Afficher le menu des stations
                                {% endif %}
                            </button>
                        </form>
                        {% if view_station %}
                            <div class="alert alert-success mt-2">
                                <strong>Le menu des stations est affiché !</strong><br>
                                <small>Dernière modification : {{ date_time_view|date("d/m/Y H:i") }}</small>
                            </div>
                        {% else %}
                            <div class="alert alert-secondary mt-2">
                                <strong>Le menu des stations est caché !</strong><br>
                                <small>Dernière modification : {{ date_time_view|date("d/m/Y H:i") }}</small>
                            </div>
                        {% endif %}
                    </div>
                </div>   
            </div>
        </div>
        <div class="card card_admin">
            <div class="card-header text-center">
                <h2>Données brut de la station Météo</h2>
            </div>
            <div class="card-body">
                <h5 class="card-title text-center">Données en direct</h5>
                <p class="text-center">Rafraîchissement des données dans <span id="compteur">30</span> seconde(s)...</p>
                <div class="row text-center">
                    <div class="col md lg sm">

                        <span id="online"></span>
                    </div>
                </div>
                <div class="row text-center">
                    <div class="col md lg sm">
                        Heure du relevé: <span id="heure_releve"> </span> Date du relevé: <span id="date_releve"> </span>
                    </div>
                </div>
                <br>
                <div class="row">
                    <div class="col-md-6 col-lg-6 col-sm-6">
                        <table id="donne_meteo" class="table table-hover">
                                <tbody>
                                <tr>
                                    <td>Température DHT22</td>
                                    <td id="temp_dht11"></td>
                                    <td>C°</td>
                                </tr>
                                <tr>
                                    <td>Température BMP280</td>
                                    <td id="temp_bmp180"></td>
                                    <td>C°</td>
                                </tr>
                                <tr>
                                    <td>Capteur de lumière</td>
                                    <td id="capt_lumi"></td>
                                    <td>lux</td>
                                </tr>
                                <tr>
                                    <td>Anemométre</td>
                                    <td id="anemo"></td>
                                    <td>Km/h</td>
                                </tr>
                                <tr>
                                    <td>Tension capteur solaire</td>
                                    <td id="tens_capt"></td>
                                    <td>vlt</td>
                                </tr>
                                <tr>
                                    <td>Taux d'ensoleilement</td>
                                    <td id="taux_soleil"></td>
                                    <td>%</td>
                                </tr>
                                <tr>
                                    <td colspan="3" id="taux">

                                    </td>
                                </tr>
                                </tbody>
                        </table>
                    </div>
                    <div class="col-md-6 col-lg-6 col-sm-6">
                        <table class="table table-hover">
                            <tbody>
                                <tr>
                                    <td>Humiditer DHT22</td>
                                    <td id="humiditer"></td>
                                    <td>%</td>
                                </tr>
                                <tr>
                                    <td>Pression atmo BMP280</td>
                                    <td id="pression"></td>
                                    <td>hpa</td>
                                </tr>
                                <tr>
                                    <td>Pluviométre</td>
                                    <td id="pluvio"></td>
                                    <td>mm</td>
                                </tr>
                                <tr>
                                    <td>Girouette</td>
                                    <td id="girou"></td>
                                    <td>°</td>
                                </tr>
                                <tr>
                                    <td>Bit de vie</td>
                                    <td id="bit_vie"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card  text-center">
            <div class="card-header">
                <h2>Alertes meteo de la station</h2>
            </div>
            <div class="card-body">
           
                <div class="table-responsive-sm table-responsive-md table-responsive-lg">
                    <div class="row">
                        <div class="col-6 text-center">
                            <h5>Alerte en cours de la station</h5>
                            {% if alerterepo %}
                            {% for alerte in alerterepo %}
                            {% set niveau = {
                                1: "Vert",
                                2: "Jaune",
                                3: "Orange",
                                4: "Rouge"
                            } %}
                            {% set couleurs = {
                                1: "#15ed13",  
                                2: "#f9ff00",  
                                3: "#f7a401",    
                                4: "#e71919"    
                            } %}
                            <table class="table">
                                <tr>
                                    <td>{{ alerte.CreatdAt|date("d/m/Y H:i") }}</td>
                                    <td>Origine: {{ alerte.origine }}</td>
                                
                                </tr>
                                <tr>
                                    <td>
                                        {% if  alerte.type == true%}
                                            Manuel
                                        {% else %}
                                            Automatique
                                        {% endif %}
                                    </td>
                                    <td>Vigilance: <strong style="color: {{ couleurs[alerte.level] }}">{{ niveau[alerte.level] ?? 'Niveau inconnu' }}</strong></td>
                                </tr>
                               
                            </table>
                            {% endfor %}
                            {% else %}
                                <span class="badge badge-success">Aucune alerte en cours</span>
                            {% endif %}
                        </div>
                        <div class="col-6">
                            <h5>Vigilance meteo France</h5>
                            {% for vigi in vigilance %}
                            {% set phenomenes = {
                                1: "Vent",
                                2: "Pluie",
                                3: "Orages",
                                4: "Crues",
                                5: "Neige / Verglas",
                                6: "Canicule",
                                7: "Grand froid",
                                8: "Avalanches",
                                9: "Vagues submersion"
                            } %}
                            {% set niveau = {
                                1: "Vert",
                                2: "Jaune",
                                3: "Orange",
                                4: "Rouge"
                            } %}
                            Information de Météo France mise a jour le {{vigi.updatedate|date("d/m/Y H:i")}}
                            <p class="card-text" style="color: {{ vigi.riskcolor }}"><strong>{{ niveau[vigi.riskcode] ?? 'Niveau inconnu' }}</strong> </p>
                                <p>Phénomene: {{ phenomenes[vigi.hazardcode] ?? 'Phénomène inconnu' }}</p>
                                <p>Debut: {{vigi.starttime|date("d/m/Y H:i")}} Fin: {{vigi.endtime|date("d/m/Y H:i")}}</p>
                                <p>{{vigi.text1}}</p> 
                                <p>{{vigi.text2}}</p>
                                <p>{{vigi.text3}}</p>
                                <p>{{vigi.text4}}</p>
                                <p>{{vigi.text21}}</p> 
                                <p>{{vigi.text22}}</p>
                                <p>{{vigi.text23}}</p>
                                <p>{{vigi.text24}}</p>
                            
                                
                            {% endfor%}
                        </div>
                    
                    </div>
                </div>
                
               
            </div>
        </div>   
         <div class="card  text-center">
            <div class="card-header">
                <h2>Inforamtion Orages</h2>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Distance</th>
                            <th scope="col">Nombre d'éclaire</th>
                            <th scope="col">Status</th>
                            <th scope="col">Interval entre eclaire</th>
                        </tr>
                    </thead>
                    <tbody>
                {% for orage in orages %}
                        <tr>
                            <td>{{ orage.datetime|date("d/m/Y H:i") }}</td>
                            <td>{{ orage.radius }} km</td>
                            <td>{{ orage.totalstrikes }}</td>
                            <td>{{ orage.status }}</td>
                            <td>{% if orage.intervals is iterable %}
                                {{ orage.intervals|join(', ') }} s
                                {% else %}
                                {{ orage.intervals }} s
                                {% endif %}
                            </td>
                        </tr>
                {% endfor %}
                    </tbody>
                </table>
            </div>
        </div> 
        
    </div>
    <script src="{{ asset('js/donnee_meteo.js') }}"></script>
    <script src="{{ asset('js/moment-with-locales.js') }}"></script>


{% endblock %}