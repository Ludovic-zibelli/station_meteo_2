{% block javascripts %}
    {{ parent() }}
    <script>
        (function(){
            console.log('stationview script initializing');
            const etatId = {{ stationmeteo.etatstationmeteo ? stationmeteo.etatstationmeteo.id : 'null' }};
            const stationDirectId = {{ stationmeteo.stationdirect ? stationmeteo.stationdirect.id : 'null' }};
            console.log('etatId, stationDirectId =', etatId, stationDirectId);

            if(!etatId && !stationDirectId){
                console.warn('Pas d\'etatStationMeteo ni stationDirect associé (id manquant)');
                return;
            }

            // Utiliser les routes API Platform en snake_case (vérifier via /api)
            const etatUrl = etatId ? `/api/etat_station_meteos/${etatId}` : null;
            const stationDirectUrl = stationDirectId ? `/api/station_directs/${stationDirectId}` : null;

            const API_KEY = '{{ api_key|default('') }}';

            const green = '{{ asset("/images/button-green.png") }}';
            const red = '{{ asset("/images/button-red.png") }}';

            function imgSrc(val){ return val == 1 ? green : red; }
            function formatDate(d){ try{ return d ? new Date(d).toLocaleString() : ''; }catch(e){return ''; } }

            async function fetchJson(url){
                try {
                    const headers = { 'Accept':'application/json' };
                    if(API_KEY) headers['x-api-key'] = API_KEY;
                    const res = await fetch(url, { headers, credentials: 'same-origin' });
                    console.log('fetch', url, 'status', res.status);
                    if(!res.ok) {
                        const txt = await res.text();
                        console.warn('API error', url, res.status, txt);
                        return null;
                    }
                    return await res.json();
                } catch (err) {
                    console.error('fetchJson error for', url, err);
                    return null;
                }
            }

            async function refreshEtat(){
                try{
                    const [etat, stationDirect] = await Promise.all([
                        etatUrl ? fetchJson(etatUrl) : Promise.resolve(null),
                        stationDirectUrl ? fetchJson(stationDirectUrl) : Promise.resolve(null)
                    ]);
                    if(stationDirect){
                        console.debug('stationDirect data', stationDirect);
                        document.getElementById('tempBmp280')?.textContent = stationDirect.tempbmp280 ?? '';
                        document.getElementById('tempDht22')?.textContent = stationDirect.tempdh22 ?? '';
                        document.getElementById('humidite')?.textContent = stationDirect.humidite ?? '';
                        document.getElementById('pression')?.textContent = stationDirect.pression ?? '';
                        document.getElementById('lumiere')?.textContent = stationDirect.lumiere ?? '';
                        document.getElementById('anemometre')?.textContent = stationDirect.anemometre ?? '';
                        document.getElementById('girouette')?.textContent = stationDirect.girouette ?? '';
                        document.getElementById('pluviometre')?.textContent = stationDirect.pluviometre ?? '';
                        document.getElementById('pointrose')?.textContent = stationDirect.pointrose ?? '';
                        document.getElementById('tempRessenti')?.textContent = stationDirect.tempressenti ?? '';
                    }
                    if(etat){
                        console.debug('etat data', etat);
                        document.getElementById('tensionSolaire')?.textContent = etat.tensionSolaire ?? etat.tensionsolaire ?? '';
                        document.getElementById('tensionBatterie')?.textContent = etat.tensionBatterie ?? etat.tensionbatterie ?? '';
                        document.getElementById('moduleBmp280Img')?.setAttribute('src', imgSrc(etat.moduleBmp280 ?? etat.modulebmp280));
                        document.getElementById('capteurDht22Img')?.setAttribute('src', imgSrc(etat.capteurDht22 ?? etat.capteurdht22));
                        document.getElementById('moduleDht22Img')?.setAttribute('src', imgSrc(etat.moduleDht22 ?? etat.moduledht22));
                        document.getElementById('capteurBmp280Img')?.setAttribute('src', imgSrc(etat.capteurBmp280 ?? etat.capteurbmp280));
                        document.getElementById('moduleAnemoImg')?.setAttribute('src', imgSrc(etat.moduleAnemo ?? etat.moduleanemo));
                        document.getElementById('capteurPluvioImg')?.setAttribute('src', imgSrc(etat.capteurPluvio ?? etat.capteurpluvio));
                        document.getElementById('moduleGirouImg')?.setAttribute('src', imgSrc(etat.moduleGirou ?? etat.modulegirou));
                        document.getElementById('capteurGirouImg')?.setAttribute('src', imgSrc(etat.capteurGirou ?? etat.capteurgirou));
                        document.getElementById('modulePluvioImg')?.setAttribute('src', imgSrc(etat.modulePluvio ?? etat.modulepluvio));
                        document.getElementById('capteurAnemoImg')?.setAttribute('src', imgSrc(etat.capteurAnemo ?? etat.capteuranemo));
                        document.getElementById('moduleTensionImg')?.setAttribute('src', imgSrc(etat.moduleTension ?? etat.moduletension));
                        document.getElementById('moduleBitvieImg')?.setAttribute('src', imgSrc(etat.moduleBitvie ?? etat.modulebitvie));

                        document.getElementById('logDateBmp280')?.textContent = formatDate(etat.logDateBmp280 ?? etat.log_date_bmp280);
                        document.getElementById('logBmp280')?.textContent = etat.logBmp280 ?? etat.log_bmp280 ?? '';
                        document.getElementById('logDateDht22')?.textContent = formatDate(etat.logDateDht22 ?? etat.log_date_dht22);
                        document.getElementById('logDht22')?.textContent = etat.logDht22 ?? etat.log_dht22 ?? '';
                        document.getElementById('logDateGirou')?.textContent = formatDate(etat.logDateGirou ?? etat.log_date_girou);
                        document.getElementById('logGirou')?.textContent = etat.logGirou ?? etat.log_girou ?? '';
                        document.getElementById('logDateAnemo')?.textContent = formatDate(etat.logDateAnemo ?? etat.log_date_anemo);
                        document.getElementById('logAnemo')?.textContent = etat.logAnemo ?? etat.log_anemo ?? '';
                        document.getElementById('logDatePluvio')?.textContent = formatDate(etat.logDatePluvio ?? etat.log_date_pluvio);
                        document.getElementById('logPluvio')?.textContent = etat.logPluvio ?? etat.log_pluvio ?? '';
                        document.getElementById('logDateTension')?.textContent = formatDate(etat.logDateTension ?? etat.log_date_tension);
                        document.getElementById('logTension')?.textContent = etat.logTension ?? etat.log_tension ?? '';
                        if(document.getElementById('ghost')) document.getElementById('ghost').textContent = etat.ghost ?? '';
                    }
                }catch(e){
                    console.error('refreshEtat error', e);
                }
            }

            // premier appel + intervalle
            refreshEtat();
            setInterval(refreshEtat, 8000);
        })();
    </script>
{% endblock %}



